<?xml version="1.0" encoding="utf-8"?>
<!-- Excludes all app data from cloud backup and device-to-device transfer so
     the auth token in secure storage / shared preferences never leaves the
     device. Android 12+ (API 31+) schema. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
